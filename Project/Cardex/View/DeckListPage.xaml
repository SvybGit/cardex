<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ViewModel;assembly=ViewModel"
             x:DataType="vm:DeckListViewModel"
             x:Class="View.DeckListPage"
             x:Name="DecksPage"
             Title="Decks">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding BindingContext.LoadDecksCommand, Source={x:Reference DecksPage}}" />
    </ContentPage.Behaviors>
            <VerticalStackLayout Padding="16" Spacing="12">
        <Button Text="Create deck"
                Command="{Binding CreateDeckCommand}" />

        <CollectionView ItemsSource="{Binding Decks}"
                        SelectedItem="{Binding SelectedDeck, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Null}">
                    <Label Text="{Binding Name}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>