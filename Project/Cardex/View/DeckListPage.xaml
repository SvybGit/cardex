<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ViewModel;assembly=ViewModel"
             x:DataType="vm:DeckListViewModel"
             x:Class="View.DeckListPage"
             x:Name="DecksPage"
             Title="Decks">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding BindingContext.LoadDecksCommand, Source={x:Reference DecksPage}}" />
    </ContentPage.Behaviors>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Export"
                     Clicked="ExportClicked" />
        <ToolbarItem Text="Import"
                     Clicked="ImportClicked" />
    </ContentPage.ToolbarItems>
    <VerticalStackLayout Padding="16" Spacing="12">
        <Button Text="Create deck"
                Command="{Binding CreateDeckCommand}" />

        <CollectionView ItemsSource="{Binding Decks}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DeckItemViewModel">
                    <Border x:Name="DeckItem"
                            Margin="0,6"
                            Padding="14,12"
                            BackgroundColor="{StaticResource Gray950}"
                            Stroke="{StaticResource Gray600}"
                            StrokeShape="RoundRectangle 8">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor"
                                                    Value="{StaticResource Gray900}" />
                                            <Setter Property="Stroke"
                                                    Value="{StaticResource PrimaryDark}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Study"
                                                Command="{Binding BindingContext.StudyDeckCommand, Source={x:Reference DecksPage}}"
                                                CommandParameter="{Binding .}" />
                                <MenuFlyoutItem Text="Edit"
                                                Command="{Binding BindingContext.EditDeckCommand, Source={x:Reference DecksPage}}"
                                                CommandParameter="{Binding .}" />
                                <MenuFlyoutItem Text="Delete"
                                                Command="{Binding BindingContext.DeleteDeckCommand, Source={x:Reference DecksPage}}"
                                                CommandParameter="{Binding .}" />
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                CommandParameter="{Binding .}"
                                Tapped="DeckItemTapped" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="8">
                            <Grid Grid.Row="0"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Grid.Column="1"
                                       Text="In progress"
                                       IsVisible="{Binding HasActiveSession}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       HorizontalTextAlignment="End"
                                       TextColor="{StaticResource PrimaryDark}" />
                            </Grid>
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0"
                                                       Spacing="6"
                                                       VerticalOptions="Center">
                                    <Label Text="{Binding CardCount, StringFormat='{0} cards'}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CategoryName, StringFormat='| {0}'}"
                                           IsVisible="{Binding HasCategory}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </HorizontalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Continue"
                                        IsVisible="{Binding HasActiveSession}"
                                        FontSize="13"
                                        Padding="12,6"
                                        MinimumHeightRequest="0"
                                        Command="{Binding BindingContext.ContinueStudyCommand, Source={x:Reference DecksPage}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
