<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:Cardex.Model.Dtos;assembly=Model"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ViewModel;assembly=ViewModel"
             x:DataType="vm:DeckListViewModel"
             x:Class="View.DeckListPage"
             x:Name="DecksPage"
             Title="Decks">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding BindingContext.LoadDecksCommand, Source={x:Reference DecksPage}}" />
    </ContentPage.Behaviors>
    <VerticalStackLayout Padding="16" Spacing="12">
        <Button Text="Create deck"
                Clicked="CreateDeckButton_OnClicked" />

        <CollectionView ItemsSource="{Binding Decks}"
                        SelectedItem="{Binding SelectedDeck, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:DeckDto">
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="0,4">
                        <Label Grid.Column="0"
                               Text="{Binding Name}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Study"
                                CommandParameter="{Binding Id}"
                                Clicked="StudyButton_OnClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
