<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ViewModel;assembly=ViewModel"
             x:DataType="vm:StudySessionViewModel"
             x:Class="View.StudySessionPage"
             x:Name="StudySession"
             Title="Study">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding BindingContext.LoadSessionCommand, Source={x:Reference StudySession}}" />
    </ContentPage.Behaviors>

    <Grid Padding="16"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="12">
        <VerticalStackLayout Grid.Row="0"
                             Spacing="8">
            <Label Text="{Binding Deck.Name, FallbackValue=''}"
                   FontAttributes="Bold" />
            <Label IsVisible="{Binding CanShowCurrentCard}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Card " />
                        <Span Text="{Binding CurrentCardNumber}" />
                        <Span Text=" / " />
                        <Span Text="{Binding TotalCards}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="12"
                             VerticalOptions="Center"
                             IsVisible="{Binding CanShowCurrentCard}">
            <Label Text="{Binding DisplayedCardText}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Flip"
                    Command="{Binding FlipCardCommand}"
                    IsVisible="{Binding CanShowCurrentCard}" />

            <VerticalStackLayout IsVisible="{Binding CanShowRatingButtons}">
                <Label HorizontalOptions="Center" Text="Rate card:" />
                <HorizontalStackLayout Spacing="8"
                                       HorizontalOptions="Center">
                    <Button Text="Again"
                            Command="{Binding RateAgainCommand}" />
                    <Button Text="Hard"
                            Command="{Binding RateHardCommand}" />
                    <Button Text="Easy"
                            Command="{Binding RateEasyCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2"
                             Spacing="12"
                             IsVisible="{Binding IsComplete}">
            <Label Text="Session complete" />
            <Button Text="End session"
                    Command="{Binding EndSessionCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
