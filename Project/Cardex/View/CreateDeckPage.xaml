<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:View.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ViewModel;assembly=ViewModel"
             x:DataType="vm:CreateDeckViewModel"
             x:Class="View.CreateDeckPage"
             x:Name="CreateDeck"
             Title="Create deck">

    <ContentPage.Resources>
        <converters:CategoryNameConverter x:Key="CategoryNameConverter" />
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding BindingContext.LoadCategoriesCommand, Source={x:Reference CreateDeck}}" />
    </ContentPage.Behaviors>

    <VerticalStackLayout Padding="16" Spacing="12">
        <Entry Placeholder="Deck name"
               Text="{Binding Name}" />

        <Picker Title="Category"
                ItemsSource="{Binding Categories}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource CategoryNameConverter}}"
                SelectedItem="{Binding SelectedCategory}" />

        <HorizontalStackLayout Spacing="8">
            <Button Text="Save"
                    Command="{Binding SaveDeckCommand}"
                    Clicked="GoBack"/>
            <Button Text="Cancel"
                    Clicked="GoBack" />
        </HorizontalStackLayout>

        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}" />
    </VerticalStackLayout>
</ContentPage>
